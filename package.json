{
  "name": "selfbot-music",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node -e \"if(process.platform!=='win32'){require('child_process').execSync('chmod +x bin/ffmpeg bin/yt-dlp',{stdio:'inherit'})}\"",
    "start": "node index.js",
    "start:win": "start.cmd",
    "start:unix": "sh ./start.sh",
    "install:win": "install.cmd",
    "install:unix": "sh ./install.sh"
  },
  "keywords": [
    "selfbot",
    "discord",
    "music"
  ],
  "author": "Tky567",
  "type": "commonjs",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^17.3.1",
    "ws": "^8.18.0",
    "yt-dlp-exec": "^1.0.1"
  }
}
